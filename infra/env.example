# TrendCast AI — environment template. Copy to .env and fill in. NEVER commit .env.
#
# The pilot is serverless (decision 027): Vercel + Render + Supabase + GitHub
# Actions. There is no VM, no broker and no Docker in that topology.
#
# Credentials are split across three trust zones. Keep them separated — the
# whole tenant-isolation model depends on it (see security.md §Credentials):
#
#   Zone A  Render (public API)   — anon key + JWT secret. NEVER the service key.
#   Zone B  GitHub Actions        — service-role key + external API keys.
#   Zone C  Vercel (browser)      — publishable NEXT_PUBLIC_* values only.
#
# This single file is a convenience for LOCAL development, where one process
# may need values from several zones. In deployment the zones never mix.

# ---------------------------------------------------------------------------
# Zone A — Render / local FastAPI
# ---------------------------------------------------------------------------
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_JWT_SECRET=your-jwt-secret

# Comma-separated exact origins. Must match the deployed frontend origin with
# no trailing slash, or every browser request fails CORS preflight.
CORS_ORIGINS=http://localhost:3000

# ---------------------------------------------------------------------------
# Zone B — GitHub Actions (producers + nightly). Set as repo Secrets, not here.
# ---------------------------------------------------------------------------
# Bypasses RLS on every table. It belongs ONLY in GitHub Secrets and local
# pipeline runs. backend/app/config.py deliberately has no field for it, so the
# API cannot read it even if it is present in the environment.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# External signal sources (both free tiers — see data_sources.md).
# Weather (Open-Meteo), holidays (Nager.Date) and trends (pytrends) need no key.
FRED_API_KEY=
TICKETMASTER_API_KEY=

# ---------------------------------------------------------------------------
# Zone C — Vercel / local Next.js. Shipped to the browser; never put a secret here.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Must include /api/v1 and must not end with a slash. Inlined at build time —
# changing it in Vercel requires a redeploy.
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# ---------------------------------------------------------------------------
# v2 / local-Docker only — NOT used by the serverless pilot
# ---------------------------------------------------------------------------
# Kafka is retained for the scale-up path and the infra/docker-compose.yml
# stack. The pilot runs with KAFKA_ENABLED=false, where the API falls back to
# NullProducer (decision 010) and signals flow through the signal_events table
# instead of topics. Leave unset unless you are running the compose stack.
KAFKA_ENABLED=false
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# Keepa / marketplace was dropped for the pilot — confirmed paid, no usable free
# tier (decision 025). Deferred to v2 via Amazon SP-API. No key is required.
