# Supabase (free tier project settings)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# FastAPI backend.
# MUST include the /api/v1 suffix and MUST NOT have a trailing slash — the client
# concatenates paths directly (`${API_URL}${path}`), so a missing suffix produces
# 404s and a trailing slash produces a double slash.
# NEXT_PUBLIC_* values are inlined at BUILD time: changing this in the Vercel
# dashboard requires a redeploy to take effect.
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
